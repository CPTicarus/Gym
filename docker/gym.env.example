# One gym's settings. Copy to gym.env next to compose.yaml and fill it in;
# after a change, `docker compose up -d` restarts the container with it.

# Where people reach the app: domain and/or IP, comma-separated. "*"
# answers on anything, which is fine while all you have is an IP.
ALLOWED_HOSTS=*

# How members get an account (apps/accounts/signup.py):
#   staff  the front desk creates every member account
#   self   people sign up on the login page; their plans stay locked until they've paid
MEMBER_SIGNUP=staff

# The first admin, made on the first start unless the username exists: a
# 10-digit national ID, and a password that passes the staff rules. Once
# you've logged in with it, delete the password from this file.
ADMIN_USERNAME=
ADMIN_NATIONAL_ID=
ADMIN_PASSWORD=

# ---- https ------------------------------------------------------------------
# Mount a certificate (compose.yaml) and https switches itself on. Say where
# it is, unless that's /certs/fullchain.pem and /certs/privkey.pem:
# TLS_CERT=/etc/letsencrypt/live/gym.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/gym.example.com/privkey.pem
#
# If https ends at a CDN or proxy in front of this server instead, say so,
# with the address ranges it connects from:
# HTTPS=true
# TRUSTED_PROXIES=203.0.113.0/24,198.51.100.0/24

# ---- optional ---------------------------------------------------------------
# Generated on the first start and kept in the data volume when unset.
# SECRET_KEY=
# gunicorn workers, about 70 MB of memory each.
# WEB_CONCURRENCY=3
# Automatic database backups: every this many hours (0 = off), keeping this many.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# These mean the same as in the project's .env.example:
# MEDIA_MAX_IMAGE_MB=8
# MEDIA_MAX_GIF_MB=15
# MEDIA_MAX_VIDEO_MB=50
# MEMBER_PASSWORD_MIN_LENGTH=4
# LOGIN_THROTTLE_RATE=10/min
# PASSWORD_CHANGE_THROTTLE_RATE=10/hour
# REGISTER_THROTTLE_RATE=20/hour
