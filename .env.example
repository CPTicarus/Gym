# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only used by settings/prod.py
DB_NAME=gym_db
DB_USER=gym_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Upload size caps per media type, in megabytes (see settings/base.py).
# WARN_* only flags the file in the UI; MAX_* is refused outright.
# Uncomment and change to tighten or loosen them for this gym.
# MEDIA_WARN_IMAGE_MB=2
# MEDIA_MAX_IMAGE_MB=8
# MEDIA_WARN_GIF_MB=5
# MEDIA_MAX_GIF_MB=15
# MEDIA_WARN_VIDEO_MB=10
# MEDIA_MAX_VIDEO_MB=50

# Shortest password a MEMBER account may have. Staff roles always use
# Django's full validators regardless (apps/accounts/passwords.py).
# MEMBER_PASSWORD_MIN_LENGTH=4
# Login attempts allowed per account per period. Keep this tight — it's
# what stops a short member PIN from being guessable.
# LOGIN_THROTTLE_RATE=10/min
# Attempts at changing your own password, per account — same reasoning.
# PASSWORD_CHANGE_THROTTLE_RATE=10/hour

# How members get an account — one workflow per gym (apps/accounts/signup.py):
#   staff  the front desk creates every member account; public sign-up is closed
#   self   people sign up from the login page and enter their measurements;
#          their plans stay locked until they've paid (an active membership)
# MEMBER_SIGNUP=staff
# Sign-ups allowed per IP address. Loose on purpose: a gym's WiFi or a mobile
# carrier can put a lot of people behind one address.
# REGISTER_THROTTLE_RATE=20/hour

