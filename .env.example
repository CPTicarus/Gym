# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only used by settings/prod.py
DB_NAME=gym_db
DB_USER=gym_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Upload size caps per media type, in megabytes (see settings/base.py).
# WARN_* only flags the file in the UI; MAX_* is refused outright.
# Uncomment and change to tighten or loosen them for this gym.
# MEDIA_WARN_IMAGE_MB=2
# MEDIA_MAX_IMAGE_MB=8
# MEDIA_WARN_GIF_MB=5
# MEDIA_MAX_GIF_MB=15
# MEDIA_WARN_VIDEO_MB=10
# MEDIA_MAX_VIDEO_MB=50
